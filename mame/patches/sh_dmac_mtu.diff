+
+// Auto-request transfers only (RS = 0100): done at once, then TE is set and DEI raised
+void sh_dmac_channel_device::check_start()
+{
+	auto *dmac = downcast<sh_dmac_device *>(owner());
+	if(!BIT(m_chcr, 0) || BIT(m_chcr, 1) || (dmac->dmaor() & 7) != 1)
+		return;
+	int rs = (m_chcr >> 8) & 15;
+	if(rs != 4) {
+		logerror("unsupported request source %x\n", rs);
+		return;
+	}
+	address_space &space = m_cpu->space(AS_PROGRAM);
+	int ts = (m_chcr >> 3) & 3;
+	int size = ts == 0 ? 1 : ts == 1 ? 2 : 4;
+	int sm = (m_chcr >> 12) & 3;
+	int dm = (m_chcr >> 14) & 3;
+	u32 count = m_dmatcr & 0xffffff;
+	if(!count)
+		count = 0x1000000;
+	for(u32 i = 0; i != count; i++) {
+		switch(size) {
+		case 1: space.write_byte(m_dar, space.read_byte(m_sar)); break;
+		case 2: space.write_word(m_dar, space.read_word(m_sar)); break;
+		default: space.write_dword(m_dar, space.read_dword(m_sar)); break;
+		}
+		if(sm == 1) m_sar += size; else if(sm == 2) m_sar -= size;
+		if(dm == 1) m_dar += size; else if(dm == 2) m_dar -= size;
+	}
+	m_dmatcr = 0;
+	m_chcr |= 2;
+	if(BIT(m_chcr, 2)) {
+		int index = tag()[strlen(tag())-1] - '0';
+		m_intc->internal_interrupt(72 + 4*index);
+	}
 }
