diff --git a/src/devices/video/sed1330.cpp b/src/devices/video/sed1330.cpp
index 31397f3b..994b382d 100644
--- a/src/devices/video/sed1330.cpp
+++ b/src/devices/video/sed1330.cpp
@@ -176,6 +176,16 @@ void sed1330_device::device_start()
 {
 	space().cache(m_cache);
 
+	// Nothing is shown until the CPU sends SYSTEM SET. Without these the first screen updates
+	// used whatever the registers held, and the scanline loop (m_cr x m_fx) could run for
+	// minutes: MAME then hung at start-up now and then.
+	m_bf = false; m_ir = 0; m_dor = 0; m_pbc = 0; m_d = false; m_sleep = false;
+	m_sag = 0; m_m0 = 0; m_m1 = 0; m_m2 = 0; m_ws = 0; m_iv = 0; m_wf = 0;
+	m_fx = 8; m_fy = 8; m_cr = 0; m_tcr = 0; m_lf = 0; m_ap = 0;
+	m_sad1 = m_sad2 = m_sad3 = m_sad4 = 0; m_sl1 = 0; m_sl2 = 0; m_hdotscr = 0;
+	m_csr = 0; m_cd = 0; m_crx = 0; m_cry = 0; m_cm = 0; m_fc = 0; m_fp = 0;
+	m_mx = 0; m_dm = 0; m_ov = 0;
+
 	// register for state saving
 	save_item(NAME(m_bf));
 	save_item(NAME(m_ir));
