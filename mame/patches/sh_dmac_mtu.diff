+
+// Auto-request transfers only (RS = 0100): done at once, then TE is set and DEI raised
+void sh_dmac_channel_device::check_start()
+{
+	auto *dmac = downcast<sh_dmac_device *>(owner());
+	if(!BIT(m_chcr, 0) || BIT(m_chcr, 1) || (dmac->dmaor() & 7) != 1) {
+		if(BIT(m_chcr, 0))
+			logerror("not started: chcr %08x dmaor %04x\n", m_chcr, dmac->dmaor());
+		return;
+	}
+	int rs = (m_chcr >> 8) & 15;
+	if(rs == 0) {
+		// external request: transfers happen on DREQ (see dreq_w); a request already pending
+		// (level mode) starts now
+		if(m_dreq)
+			m_dreq_timer->adjust(attotime::zero);
+		return;
+	}
+	if(rs != 4) {
+		logerror("unsupported request source %x sar %08x dar %08x tcr %06x chcr %08x\n", rs, m_sar, m_dar, m_dmatcr, m_chcr);
+		return;
+	}
+	if(m_active)
+		return;
+	// Takes time on the real chip (about two bus cycles per unit); finishing at once would raise
+	// DEI inside the interrupt handler that started the transfer
+	m_active = true;
+	u32 units = m_dmatcr & 0xffffff;
+	m_timer->adjust(m_cpu->cycles_to_attotime(4 * (units ? units : 0x1000000)));
+}
+
+TIMER_CALLBACK_MEMBER(sh_dmac_channel_device::transfer_done)
+{
+	m_active = false;
+	if(!BIT(m_chcr, 0) || BIT(m_chcr, 1))
+		return;
+	address_space &space = m_cpu->space(AS_PROGRAM);
+	int ts = (m_chcr >> 3) & 3;
+	int size = ts == 0 ? 1 : ts == 1 ? 2 : 4;
+	int sm = (m_chcr >> 12) & 3;
+	int dm = (m_chcr >> 14) & 3;
+	u32 count = m_dmatcr & 0xffffff;
+	if(!count)
+		count = 0x1000000;
+	for(u32 i = 0; i != count; i++) {
+		switch(size) {
+		case 1: space.write_byte(m_dar, space.read_byte(m_sar)); break;
+		case 2: space.write_word(m_dar, space.read_word(m_sar)); break;
+		default: space.write_dword(m_dar, space.read_dword(m_sar)); break;
+		}
+		if(sm == 1) m_sar += size; else if(sm == 2) m_sar -= size;
+		if(dm == 1) m_dar += size; else if(dm == 2) m_dar -= size;
+	}
+	m_dmatcr = 0;
+	m_chcr |= 2;
+	if(BIT(m_chcr, 2)) {
+		int index = tag()[strlen(tag())-1] - '0';
+		m_intc->internal_interrupt(72 + 4*index);
+	}
+}
+
+void sh_dmac_channel_device::dreq_w(int state)
+{
+	bool old = m_dreq;
+	m_dreq = state;
+	// DS (bit 6): 1 = edge, 0 = level; either way a new assertion moves one unit. Done from a
+	// timer so the requesting device is not re-entered from its own callback.
+	if(state && !old)
+		m_dreq_timer->adjust(attotime::zero);
+}
+
+TIMER_CALLBACK_MEMBER(sh_dmac_channel_device::dreq_transfer)
+{
+	auto *dmac = downcast<sh_dmac_device *>(owner());
+	if(!BIT(m_chcr, 0) || BIT(m_chcr, 1) || (dmac->dmaor() & 7) != 1 || ((m_chcr >> 8) & 15) != 0)
+		return;
+	address_space &space = m_cpu->space(AS_PROGRAM);
+	int ts = (m_chcr >> 3) & 3;
+	int size = ts == 0 ? 1 : ts == 1 ? 2 : 4;
+	int sm = (m_chcr >> 12) & 3;
+	int dm = (m_chcr >> 14) & 3;
+	switch(size) {
+	case 1: space.write_byte(m_dar, space.read_byte(m_sar)); break;
+	case 2: space.write_word(m_dar, space.read_word(m_sar)); break;
+	default: space.write_dword(m_dar, space.read_dword(m_sar)); break;
+	}
+	if(sm == 1) m_sar += size; else if(sm == 2) m_sar -= size;
+	if(dm == 1) m_dar += size; else if(dm == 2) m_dar -= size;
+	m_dmatcr = (m_dmatcr - 1) & 0xffffff;
+	if(!m_dmatcr) {
+		m_chcr |= 2;
+		if(m_tend)
+			m_tend();
+		if(BIT(m_chcr, 2)) {
+			int index = tag()[strlen(tag())-1] - '0';
+			m_intc->internal_interrupt(72 + 4*index);
+		}
+	} else if(m_dreq && !BIT(m_chcr, 6))
+		m_dreq_timer->adjust(attotime::zero);   // level mode: request still held
 }
