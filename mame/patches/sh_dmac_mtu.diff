+// External edge on TIOCnX configured as input capture (edge selection left to the caller)
+void sh_mtu_channel_device::input_capture(int tgr)
+{
+	if(tgr >= m_tgr_count)
+		return;
+	m_cpu->internal_update();
+	m_tgr[tgr] = m_tcnt;
+	m_tsr |= 1 << tgr;
+	if(BIT(m_tier, tgr) && m_interrupt[tgr] != -1)
+		m_intc->internal_interrupt(m_interrupt[tgr]);
+}
